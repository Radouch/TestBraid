{
  "name": "testbraid-frontend",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:schemas": "tsx scripts/test-schema-fixtures.ts",
    "test:editor": "tsx scripts/test-question-model.ts",
    "test:published": "tsx scripts/test-published-readonly.ts",
    "test:learner": "tsx scripts/test-learner-scoring.ts",
    "test:runner": "node scripts/run-dom-tests.mjs",
    "test:author": "node scripts/run-dom-tests.mjs scripts/test-author-editor-dom.ts",
    "test:content": "node scripts/run-dom-tests.mjs scripts/test-content-editor-dom.ts",
    "test:upload": "node scripts/run-dom-tests.mjs scripts/test-upload-dom.ts",
    "test:navigation": "tsx scripts/test-navigation.ts",
    "test:base": "tsx scripts/test-deployment-base.ts",
    "test:branding": "tsx scripts/test-site-identity.ts",
    "test:locales": "tsx scripts/test-ui-languages.ts",
    "test:security": "node scripts/run-dom-tests.mjs scripts/test-security-diagnostics-dom.ts"
  },
  "dependencies": {
    "ajv": "^8.17.1",
    "bootstrap": "^5.3.0",
    "bootstrap-icons": "1.13.2",
