{
  "name": "testbraid/api",
  "description": "TestBraid JSON/file-backed Slim 4 API",
  "type": "project",
  "require": {
    "php": "^8.1",
    "ext-fileinfo": "*",
    "slim/slim": "^4.15.3",
    "slim/psr7": "^1.6",
    "opis/json-schema": "^2.6"
  },
  "config": {
    "sort-packages": true,
    "optimize-autoloader": true
  },
  "scripts": {
    "lint": "find public src bin -type f -name '*.php' -exec php -l {} \\;",
    "test:schemas": "php bin/test-schema-fixtures.php",
    "test:auth": "bash bin/test-auth-smoke.sh",
    "test:setup": "bash bin/test-first-author-setup.sh",
    "test:storage": "php bin/test-storage-failures.php",
    "test:storage-roots": "php bin/test-storage-public-root.php",
    "test:storage-http": "bash bin/test-storage-http.sh",
    "test:media-http": "bash bin/test-media-http.sh",
    "test:publication-http": "bash bin/test-publication-http.sh"
  },
  "autoload": {
    "psr-4": {
      "TestBraid\\": "src/"
    }
  }
}
