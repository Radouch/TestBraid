{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.testbraid.invalid/v1/content-block.schema.json",
  "oneOf": [
    {
      "type": "object",
      "required": [
        "id",
        "type",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "type": {
          "const": "text"
        },
        "text": {
          "type": "string",
          "maxLength": 100000
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "id",
        "type",
        "mediaId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "type": {
          "const": "image"
        },
        "mediaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "alt": {
          "description": "Text alternative for screen readers: the image's alt text or the video's accessible name. Required for publication when the media is the only content of a choice option or matching item.",
          "type": "string",
          "maxLength": 500
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "id",
        "type",
        "mediaId"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "type": {
          "const": "video"
        },
        "mediaId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "alt": {
          "description": "Text alternative for screen readers: the image's alt text or the video's accessible name. Required for publication when the media is the only content of a choice option or matching item.",
          "type": "string",
          "maxLength": 500
        }
      },
      "additionalProperties": false
    }
  ]
}
