# Apache rewrite rules for the application's public document root.
# [END] prevents additional per-directory rewrites after choosing a target.
# Avoid Options directives: not all shared hosts permit overriding them.
RewriteEngine On

# Pass API requests to Slim; preserve the original URI for route matching.
# Skip the physical entry point to avoid rewriting it back into itself.
RewriteRule ^api/index\.php$ - [END]
RewriteRule ^api(/.*)?$ api/index.php [END]

# Missing media must return an actual 404 rather than the SPA's HTML.
RewriteRule ^media(/|$) - [END]

# Serve existing static files normally and let Vue Router handle other URLs.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [END]
